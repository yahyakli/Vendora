JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRY_SHORT=86400000
JWT_EXPIRY_LONG=604800000
GOOGLE_CLIENT_ID=your-google-client-id
