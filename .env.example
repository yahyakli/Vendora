# --- Auth Service ---
JWT_SECRET=your-256-bit-random-secret
JWT_EXPIRY_SHORT=86400
JWT_EXPIRY_LONG=604800
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Databases ---
POSTGRES_USER=vendora
POSTGRES_PASSWORD=pass
POSTGRES_DB_AUTH=auth_db
POSTGRES_DB_PRODUCT=product_db
POSTGRES_URL=postgresql://vendora:pass@postgres:5432/auth_db

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=vendora
MYSQL_PASSWORD=pass
MYSQL_DB_ORDER=order_db
MYSQL_DB_ANALYTICS=analytics_db
MYSQL_URL=mysql://vendora:pass@mysql:3306/order_db

MONGO_USER=vendora
MONGO_PASS=pass
MONGO_URL=mongodb://vendora:pass@mongodb:27017/chat_db

REDIS_PASSWORD=redispass
REDIS_URL=redis://:redispass@redis:6379

# --- RabbitMQ ---
RABBITMQ_USER=vendora
RABBITMQ_PASS=pass
RABBITMQ_URL=amqp://vendora:pass@rabbitmq:5672

# --- MinIO (S3) ---
MINIO_ROOT_USER=vendora_admin
MINIO_ROOT_PASSWORD=your-minio-secret
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=vendora_admin
MINIO_SECRET_KEY=your-minio-secret
MINIO_BUCKET_PRODUCTS=vendora-products
MINIO_BUCKET_AVATARS=vendora-avatars
MINIO_BUCKET_DIGITAL=vendora-digital
MINIO_BUCKET_INVOICES=vendora-invoices

# --- External APIs ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SENDGRID_API_KEY=SG.xxxxx
FCM_SERVER_KEY=AAAAxxxxx

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SOCKET_URL=ws://localhost/api/chat
VITE_API_URL=http://localhost

# --- Internal Service URLs ---
AI_RANKER_URL=http://ai_ranking:8085
STORAGE_SERVICE_URL=http://storage:8087

# --- Other ---
MODEL_PATH=/app/models/model.lgb
LOG_LEVEL=debug
